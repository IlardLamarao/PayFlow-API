      "name": "2. Consultar extrato - GET /api/v1/clientes/{cnpj_cpf}/extrato",
      "item": [
        {
          "name": "200 - Extrato do cliente (CPF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const ex = pm.response.json();",
                  "pm.test('Estrutura do ExtratoClienteDTO', () => {",
                  "    pm.expect(ex).to.have.all.keys('cliente_cnpj_cpf', 'cliente_nome', 'total_pendente_reais', 'total_pago_reais', 'faturas');",
                  "    pm.expect(ex.cliente_cnpj_cpf).to.eql(pm.collectionVariables.get('cpf'));",
                  "    pm.expect(ex.faturas).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('Totais batem com as faturas PENDENTE e PAGA', () => {",
                  "    const soma = (st) => Math.round(ex.faturas.filter(f => f.status === st).reduce((t, f) => t + f.valor_reais, 0) * 100) / 100;",
                  "    pm.expect(ex.total_pendente_reais).to.eql(soma('PENDENTE'));",
                  "    pm.expect(ex.total_pago_reais).to.eql(soma('PAGA'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1/clientes/{{cpf}}/extrato", "host": ["{{base_url}}"], "path": ["api", "v1", "clientes", "{{cpf}}", "extrato"] }
